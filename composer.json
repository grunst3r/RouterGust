{
    "name": "luigu/router-gust",
    "description": "Router PHP profesional con soporte para middleware, grupos, inyección de dependencias, subdominios y más.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/grunst3r/RouterGust",
    "keywords": [
        "router",
        "php",
        "routing",
        "http",
        "api",
        "rest",
        "middleware",
        "subdomain",
        "dependency-injection"
    ],
    "authors": [
        {
            "name": "Luis Gustavo",
            "email": "grunst3r@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "GustRouter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GustRouter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    }
}
