{
    "name": "luigu/router-gust",
    "description": "Router PHP profesional con soporte para middleware, grupos, inyección de dependencias, subdominios y más.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/grunst3r/RouterGust",
    "authors": [
        {
            "name": "Luis Gustavo",
            "email": "grunst3r@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "GustRouter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GustRouter\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^12.4"
    },
    "scripts": {
        "test": "phpunit tests/",
        "test-coverage": "phpunit --coverage-html coverage tests/"
    }
}
